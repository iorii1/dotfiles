/* Generated by matugen -- do not edit by hand.
 * Defines the same named colors GTK4/libadwaita apps use (in case a
 * GTK3 theme actually consumes them, e.g. adw-gtk3), but the bundled
 * Adwaita GTK3 theme itself does NOT: its compiled-in stylesheet hardcodes
 * literal hex colors for window/headerbar/button backgrounds instead of
 * reading @theme_selected_bg_color/etc (verified against gtk3 3.24.52), so
 * the explicit selector overrides below are what actually retheme it.
 */

@define-color accent_color {{colors.primary.default.hex}};
@define-color accent_bg_color {{colors.primary.default.hex}};
@define-color accent_fg_color {{colors.on_primary.default.hex}};

@define-color window_bg_color {{colors.background.default.hex}};
@define-color window_fg_color {{colors.on_background.default.hex}};

@define-color view_bg_color {{colors.surface_container_low.default.hex}};
@define-color view_fg_color {{colors.on_surface.default.hex}};

@define-color headerbar_bg_color {{colors.surface_container.default.hex}};
@define-color headerbar_fg_color {{colors.on_surface.default.hex}};
@define-color headerbar_border_color {{colors.on_surface.default.hex}};
@define-color headerbar_backdrop_color @window_bg_color;
@define-color headerbar_shade_color rgba(0, 0, 0, 0.12);

@define-color card_bg_color {{colors.surface_container.default.hex}};
@define-color card_fg_color {{colors.on_surface.default.hex}};
@define-color card_shade_color rgba(0, 0, 0, 0.12);

@define-color dialog_bg_color {{colors.surface_container_high.default.hex}};
@define-color dialog_fg_color {{colors.on_surface.default.hex}};

@define-color popover_bg_color {{colors.surface_container_high.default.hex}};
@define-color popover_fg_color {{colors.on_surface.default.hex}};

@define-color shade_color rgba(0, 0, 0, 0.12);
@define-color scrollbar_outline_color {{colors.outline.default.hex}};

@define-color destructive_color {{colors.red.default.hex}};
@define-color destructive_bg_color {{colors.red.default.hex}};
@define-color destructive_fg_color #ffffff;

@define-color success_color {{colors.green.default.hex}};
@define-color success_bg_color {{colors.green.default.hex}};
@define-color success_fg_color #ffffff;

@define-color warning_color {{colors.yellow.default.hex}};
@define-color warning_bg_color {{colors.yellow.default.hex}};
@define-color warning_fg_color #1a1a1a;

@define-color error_color {{colors.error.default.hex}};
@define-color error_bg_color {{colors.error.default.hex}};
@define-color error_fg_color {{colors.on_error.default.hex}};

/* Legacy GTK3 names some non-Adwaita themes/apps still reference. */
@define-color borders {{colors.outline.default.hex}};
@define-color unfocused_borders {{colors.outline_variant.default.hex}};
@define-color theme_bg_color @window_bg_color;
@define-color theme_fg_color @window_fg_color;
@define-color theme_base_color @view_bg_color;
@define-color theme_text_color @view_fg_color;
@define-color theme_selected_bg_color @accent_bg_color;
@define-color theme_selected_fg_color @accent_fg_color;

/* --- explicit overrides for the bundled Adwaita GTK3 theme ------------- */
/* This stylesheet loads at GTK_STYLE_PROVIDER_PRIORITY_USER, above the
 * theme's own APPLICATION-priority rules, so these win regardless of the
 * theme's selector specificity. */

window, .background {
    background-color: @window_bg_color;
    color: @window_fg_color;
}

headerbar, headerbar:backdrop {
    background: @headerbar_bg_color;
    color: @headerbar_fg_color;
    box-shadow: none;
    text-shadow: none;
}

.view, textview.view, treeview.view, list, list.view {
    background-color: @view_bg_color;
    color: @view_fg_color;
}

popover.background, popover.background > * {
    background-color: @popover_bg_color;
    color: @popover_fg_color;
}

button.suggested-action,
button.suggested-action:hover,
button.suggested-action:backdrop {
    background-image: none;
    background-color: @accent_bg_color;
    color: @accent_fg_color;
    border-color: @accent_bg_color;
    text-shadow: none;
    box-shadow: none;
}
button.suggested-action:active,
button.suggested-action:checked {
    background-image: none;
    background-color: shade(@accent_bg_color, 0.85);
    color: @accent_fg_color;
    text-shadow: none;
    box-shadow: none;
}

button.destructive-action,
button.destructive-action:hover,
button.destructive-action:backdrop {
    background-image: none;
    background-color: @destructive_bg_color;
    color: @destructive_fg_color;
    border-color: @destructive_bg_color;
    text-shadow: none;
    box-shadow: none;
}
button.destructive-action:active,
button.destructive-action:checked {
    background-image: none;
    background-color: shade(@destructive_bg_color, 0.85);
    color: @destructive_fg_color;
    text-shadow: none;
    box-shadow: none;
}
